# ---------------------------------------------------------------------------
# LunaDesk environment template
#
# Copy to .env.local for local development. NEVER commit real secrets.
#
# Only publishable values belong in the browser bundle. The Supabase anon /
# publishable key is designed to be public — Row Level Security is what
# protects your data. The service_role key must NEVER appear in this file, in
# .env.local, or anywhere in src/.
#
# The placeholders below (YOUR-PROJECT, your-anon-publishable-key, …) are
# deliberately recognisable: a live build that still contains them FAILS, so a
# half-configured site can never be published. Replace them, or build in demo
# mode.
# ---------------------------------------------------------------------------

# --- Frontend (browser bundle) ---------------------------------------------

# "live" is the default and the only mode that talks to Supabase.
# Set VITE_DATA_MODE=demo to build the clearly-labelled offline demo instead;
# demo mode needs no Supabase project at all.
#
# A live production build fails if VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY
# are missing, still contain the placeholders below, or point at a non-https
# host (localhost is allowed for `supabase start`). The check lives in
# vite.config.ts and never runs for `vite dev`, which only warns.
VITE_DATA_MODE=live

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable / anon key from Project Settings → API.
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Shown in the UI footer / receipts as the support contact.
VITE_SUPPORT_EMAIL=hello@managedbyluna.com

# Web Push public key (see scripts/generate-vapid-keys.mjs). Without it the app
# still shows in-app reminders; it just cannot ask the service worker to
# deliver notifications while the tab is closed.
VITE_VAPID_PUBLIC_KEY=

# --- Build-time only (not exposed to the browser) ---------------------------

# Vite `base` path. For https://<user>.github.io/<repo>/ use "/<repo>/";
# for a custom domain or a user/organisation Pages site use "/".
BASE_PATH=/

# --- Supabase Edge Function secrets (server side only) ----------------------
#
# Set these with:  supabase secrets set NAME=value
# They are listed here as documentation only. Do not uncomment them into this
# file and never copy them into the frontend build.

# APP_ORIGINS is REQUIRED, not optional: the functions only answer the exact
# origins listed there. If it is unset, every browser request from the app is
# refused by CORS (fail-closed). Comma separated, no trailing slashes.
#   APP_ORIGINS=https://your-user.github.io,http://localhost:5173
#
# SUPABASE_SERVICE_ROLE_KEY   injected by Supabase — never set by hand
# VAPID_PUBLIC_KEY=           must match VITE_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=          secret
# VAPID_SUBJECT=mailto:hello@managedbyluna.com
# CRON_SECRET=                random string; the scheduler sends it as x-cron-secret
