# ---------------------------------------------------------------------------
# LunaDesk environment
# Copy to .env.local for local development. NEVER commit real secrets.
# Only publishable values belong in the browser bundle: the Supabase anon /
# publishable key is designed to be public — Row Level Security is what
# protects your data. The service_role key must NEVER appear here.
# ---------------------------------------------------------------------------

# live  -> talk to your Supabase project (production)
# demo  -> run fully client-side with a clearly-labelled demo dataset
VITE_DATA_MODE=live

# Your Supabase project URL and publishable (anon) key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Shown in the UI footer / receipts as the support contact.
VITE_SUPPORT_EMAIL=hello@managedbyluna.com

# Web Push public key (see scripts/generate-vapid-keys.mjs).
# Without it the app still shows in-app reminders; it just cannot ask the
# service worker to deliver notifications while the tab is closed.
VITE_VAPID_PUBLIC_KEY=

# Build-time only (not exposed to the browser): Vite `base` path.
# For https://<user>.github.io/<repo>/ use "/<repo>/"; for a custom domain use "/".
BASE_PATH=/

# ---------------------------------------------------------------------------
# The values below are for the Edge Functions only. Set them with
#   supabase secrets set NAME=value
# They must never be copied into this file or into the frontend build.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY   injected by Supabase — never set by hand
# VAPID_PUBLIC_KEY=           same key as VITE_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=          secret
# VAPID_SUBJECT=mailto:hello@managedbyluna.com
# CRON_SECRET=                random string; the scheduler sends it as x-cron-secret
# APP_ORIGINS=https://your-user.github.io,http://localhost:5173
