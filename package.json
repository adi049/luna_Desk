{
  "name": "lunadesk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LunaDesk \u2014 the client & agency workspace for Managed by Luna",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "verify:db": "scripts/verify-migrations.sh",
    "keys:vapid": "node scripts/generate-vapid-keys.mjs",
    "check:rpc": "node scripts/check-rpc-contract.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:secrets:history": "node scripts/scan-secrets.mjs --history",
    "verify": "tsc --noEmit && node scripts/check-rpc-contract.mjs && node scripts/check-edge-queries.mjs && node scripts/scan-secrets.mjs && node scripts/check-env.mjs --self-test",
    "test:verifier": "scripts/test-verify-migrations.sh",
    "test:concurrency": "scripts/test-admin-concurrency.sh",
    "test:bootstrap": "scripts/test-bootstrap.sh",
    "test:db": "scripts/verify-migrations.sh && scripts/test-bootstrap.sh && scripts/test-admin-concurrency.sh",
    "build:demo": "VITE_DATA_MODE=demo SOURCEMAP=false vite build",
    "test:e2e": "playwright test",
    "check:env": "node scripts/check-env.mjs",
    "test:env": "node scripts/check-env.mjs --self-test",
    "check:edge": "node scripts/check-edge-queries.mjs",
    "test:edge": "node scripts/check-edge-queries.mjs --self-test",
    "test:functions": "deno test --allow-env supabase/functions/tests/",
    "check:functions": "deno check supabase/functions/admin-clients/handler.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
